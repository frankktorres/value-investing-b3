# Dados brutos reproduzíveis (CVM/StatusInvest) — não versionar
ferramentas/dados/cvm/*.zip
# Documentos do RAD/IPE baixados para os dossiês (DFP completo, fatos relevantes) — rebaixáveis pelo protocolo citado no dossiê
ferramentas/dados/cvm/docs/
ferramentas/dados/raw/
# Derivados do backtest (reconstruíveis dos ZIPs da CVM por backtest/ledger/*)
ferramentas/backtest/dados/
# Pipeline antigo (histórico, fora do fluxo atual)
analisador/.venv/
analisador/dados/
# Python
__pycache__/
*.pyc
.pytest_cache/
# Segredos
.env*
*.key
*.pem
*.p12
# Carteira real (quantidade, preço médio, corretora) — nunca no git
carteira.local*
carteira-real*
# Painel da carteira (quantidades, valores, renda em R$) — relatorio CARTEIRA grava só aqui e confere antes (git check-ignore)
RELATORIOS/privado/
# Histórico da renda rumo à meta (R$ por pregão) — pessoal, escrito por relatorio CARTEIRA
ferramentas/dados/privado/
# Registro da última suíte completa (conftest.py → tela Sistema)
ferramentas/dados/suite_ultima.json
# Dados da tela (painel web): JSON regerável por `python -m painel.exportar`; a parte pessoal vai em dados/privado/
ferramentas/painel/web/dados/
# Capturas e logs do Playwright MCP (conferência da tela no navegador)
.playwright-mcp/
# Log da última execução do monitor semanal (Etapa 4)
ferramentas/monitor/ultimo.log
# Logs do painel e da temporada (o painel pode ecoar valor pessoal em mensagem de erro)
ferramentas/monitor/*.log

# Projeto antigo arquivado em 08/10/2026 (git próprio; ver analisador/ARQUIVADO.md)
analisador/
